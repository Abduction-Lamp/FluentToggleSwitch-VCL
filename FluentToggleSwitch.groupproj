<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4A4D3CB0-7C52-452D-A027-DD0424B956A2}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="packages\FluentToggleSwitchR.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="packages\FluentToggleSwitchD.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="demo\Demo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="tests\Tests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="FluentToggleSwitchR">
        <MSBuild Projects="packages\FluentToggleSwitchR.dproj"/>
    </Target>
    <Target Name="FluentToggleSwitchR:Clean">
        <MSBuild Projects="packages\FluentToggleSwitchR.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FluentToggleSwitchR:Make">
        <MSBuild Projects="packages\FluentToggleSwitchR.dproj" Targets="Make"/>
    </Target>
    <Target Name="FluentToggleSwitchD">
        <MSBuild Projects="packages\FluentToggleSwitchD.dproj"/>
    </Target>
    <Target Name="FluentToggleSwitchD:Clean">
        <MSBuild Projects="packages\FluentToggleSwitchD.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FluentToggleSwitchD:Make">
        <MSBuild Projects="packages\FluentToggleSwitchD.dproj" Targets="Make"/>
