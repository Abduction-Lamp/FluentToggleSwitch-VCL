    </Target>
    <Target Name="Build">
        <CallTarget Targets="FluentToggleSwitchR;FluentToggleSwitchD;Demo;Tests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FluentToggleSwitchR:Clean;FluentToggleSwitchD:Clean;Demo:Clean;Tests:Clean"/>
