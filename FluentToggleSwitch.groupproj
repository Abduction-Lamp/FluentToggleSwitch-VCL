    <Target Name="Make">
        <CallTarget Targets="FluentToggleSwitchR:Make;FluentToggleSwitchD:Make;Demo:Make;Tests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
